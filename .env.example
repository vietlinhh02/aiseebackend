# Database
DATABASE_URL=postgres://aisee:aisee@localhost:5435/aisee?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6380/0

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production

# Internal API Key (for AI agent communication)
INTERNAL_API_KEY=your-internal-api-key

# Google Sign-In (Web Client ID from Google Cloud Console)
# Tìm trong Credentials -> Web application -> Client ID
GOOGLE_WEB_CLIENT_ID=426558011849-rgvtpskfhennhjg5p5r3knu9hau436c8.apps.googleusercontent.com

# LiveKit (for video calls)
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# AI agent
AI_TRANSPORT=websocket
# Host backend uses 127.0.0.1 because docker-compose publishes agent port 8765.
ASSISTANT_BRIDGE_URL=ws://127.0.0.1:8765/ws
# Docker backend should use the compose service DNS instead.
DOCKER_ASSISTANT_BRIDGE_URL=ws://agent:8765/ws
ASSISTANT_WS_HOST=0.0.0.0
ASSISTANT_WS_PORT=8765
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Aoede
GEMINI_THINKING_LEVEL=low
GEMINI_AUDIO_SAMPLE_RATE=16000
GEMINI_RESPONSE_AUDIO_SAMPLE_RATE=24000
GEMINI_VIDEO_ENABLED=true
GEMINI_VIDEO_FPS_SPEAKING=1
GEMINI_VIDEO_FPS_IDLE=0.33
GEMINI_GOOGLE_SEARCH_ENABLED=false
EXA_API_KEY=your-exa-api-key
EXA_SEARCH_MAX_RESULTS=3

# Push Notifications
FCM_SERVICE_ACCOUNT_PATH=/path/to/fcm-service-account.json
APNS_KEY_PATH=/path/to/apns-key.p8
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-team-id
APNS_BUNDLE_ID=com.aisee.app

# S3 / MinIO (file uploads)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aisee
S3_USE_SSL=false

# Server
PORT=8080

# Domain (for production/development with tunnel)
DOMAIN=data.visme.tech
PUBLIC_API_BASE_URL=https://data.visme.tech

# RevenueCat webhook authorization.
# In RevenueCat dashboard, set Authorization header value to:
# Bearer <REVENUECAT_WEBHOOK_AUTH>
REVENUECAT_WEBHOOK_AUTH=change-me

# Optional product override map, e.g.
# rc_basic=basic_149k,rc_plus=plus_399k,rc_premium=premium_599k
REVENUECAT_PRODUCT_PLAN_MAP=
