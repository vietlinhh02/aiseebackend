# Database
DATABASE_URL=postgres://aisee:aisee@localhost:5435/aisee?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6380/0

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production

# Internal API Key (for AI agent communication)
INTERNAL_API_KEY=your-internal-api-key

# Google Sign-In (Web Client ID from Google Cloud Console)
# Tìm trong Credentials -> Web application -> Client ID
GOOGLE_WEB_CLIENT_ID=426558011849-rgvtpskfhennhjg5p5r3knu9hau436c8.apps.googleusercontent.com

# LiveKit (for video calls)
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Push Notifications
FCM_SERVICE_ACCOUNT_PATH=/path/to/fcm-service-account.json
APNS_KEY_PATH=/path/to/apns-key.p8
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-team-id
APNS_BUNDLE_ID=com.aisee.app

# S3 / MinIO (file uploads)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aisee
S3_USE_SSL=false

# Server
PORT=8080

# Domain (for production/development with tunnel)
DOMAIN=data.visme.tech
